msgid "1. Check each pairing: the icons say what matched. 2. Click a line to pre-approve it. 3. Validate them all at once; invoices get their payment created."
msgstr "1. Vérifiez chaque proposition : les icônes disent ce qui correspond. 2. Cliquez sur une ligne pour la pré-approuver. 3. Validez-les toutes d'un coup ; les factures reçoivent leur paiement."

msgid "A bank line is reconciled with documents of a single type, got {0}"
msgstr "Une ligne bancaire se rapproche avec des documents d'un seul type, reçu {0}"

msgid "Already reconciled"
msgstr "Déjà rapprochées"

msgid "Bank Transaction {0} is not submitted"
msgstr "La transaction bancaire {0} n'est pas validée"

msgid "Bank account"
msgstr "Compte bancaire"

msgid "Bank reconciliation"
msgstr "Rapprochement bancaire"

msgid "Cancel the payment"
msgstr "Annuler le paiement"

